<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Dokkit" suffix=" · Dokkit">{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link phx-track-static rel="stylesheet" href={~p"/vendor/phosphor.css"} />
    <link rel="preload" href={~p"/vendor/figtree-latin-wght-normal.woff2"} as="font" type="font/woff2" crossorigin />
    <link phx-track-static rel="stylesheet" href={~p"/css/dokkit.css"} />
    <script>
      var dokkitState = {};
      try { dokkitState = JSON.parse(localStorage.getItem("dokkit-look")) || {}; } catch (e) {}
      function dokkitLook(key, value) {
        if (key) {
          value ? dokkitState[key] = value : delete dokkitState[key];
          try { localStorage.setItem("dokkit-look", JSON.stringify(dokkitState)); } catch (e) {}
        }
        var s = dokkitState, dark = s.theme ? s.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        var base = ["neutral", "plum", "slate", "ember"].indexOf(s.base) < 0 ? "ember" : s.base;
        var accent = ["violet", "orange", "blue", "teal"].indexOf(s.accent) < 0 ? "orange" : s.accent;
        document.documentElement.className = [dark ? "t-dark" : "", base !== "neutral" ? "d-" + base : "", accent !== "violet" ? "a-" + accent : ""].filter(Boolean).join(" ");
        document.querySelectorAll("[data-look]").forEach(function (b) {
          var k = b.dataset.look, v = k === "base" ? base : k === "accent" ? accent : s.theme || "";
          b.classList.toggle("on", v === b.dataset.value);
          b.setAttribute("aria-pressed", v === b.dataset.value);
        });
      }
      dokkitLook();
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
